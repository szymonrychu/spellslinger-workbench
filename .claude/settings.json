{
  "extraKnownMarketplaces": {
    "spellslinger-workbench": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  },
  "enabledPlugins": {
    "workbench@spellslinger-workbench": true,
    "workbench-infra@spellslinger-workbench": false,
    "workbench-observability@spellslinger-workbench": false,
    "workbench-secrets@spellslinger-workbench": false
  },
  "permissions": {
    "allow": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/cloud_session_start.py\"",
            "timeout": 600,
            "statusMessage": "Preparing the cloud session..."
          }
        ]
      }
    ]
  }
}
